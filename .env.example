# Copy to .env and fill in before: docker compose --env-file .env up --build

POSTGRES_PASSWORD=change-me-strong
DB_USER=societycare
DB_PASSWORD=change-me-strong
# Base64-encoded HS256 secret (>= 256 bits). Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Only needed if frontend and API are on different origins (split dev servers).
# Behind nginx (docker compose default), leave unset or use http://localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost

WEB_PORT=80

# --- GitHub Actions / VPS deploy (set as repository secrets) ---
# DEPLOY_HOST=
# DEPLOY_USER=deploy
# DEPLOY_SSH_KEY=
# GITHUB_REPOSITORY owner is inferred by workflow; image tags use ghcr.io/<owner>/societycare-api
