<?xml version="1.0" encoding="UTF-8"?>
<!--
    Project-local Maven settings for SocietyCare backend.

    Use with:
        mvn -s settings.xml <goal>

    This file deliberately overrides the corporate Maven settings so the build
    pulls dependencies from Maven Central directly. No corporate mirrors,
    repositories, or credentials are referenced anywhere.

    Local artifact cache stays under the default ${user.home}/.m2/repository,
    so dependencies download once and are reused by other projects.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- No <mirrors> block on purpose: Maven Central is used directly. -->
    <!-- No <servers> block on purpose: no authenticated repositories. -->

    <profiles>
        <profile>
            <id>maven-central-only</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <repository>
                    <id>central</id>
                    <name>Maven Central</name>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <name>Maven Central</name>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

</settings>
