[Unit]
Description=Nightly SocietyCare database backup (%i)

[Timer]
# 03:10 UTC = 08:40 IST. Quiet hours either way, and clear of the notification
# retention sweep the application runs at 03:30 in its own timezone.
OnCalendar=*-*-* 03:10:00 UTC

# Spread the two environments a little so they are not dumping at the same
# instant on a 2 GB box.
RandomizedDelaySec=5min

# If the server was off at 03:10, run as soon as it is back rather than skipping
# the night entirely. A missed backup is the one you will want.
Persistent=true

[Install]
WantedBy=timers.target
