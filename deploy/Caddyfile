# Caddy runs on the host (not in Docker) and is the only thing the internet can
# reach. It terminates HTTPS and forwards to the web container of each stack.
#
#   sudo cp /opt/societycare/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Naming a domain here is what triggers the certificate: Caddy obtains one from
# Let's Encrypt automatically and renews it forever. Every name below must
# already resolve to this server (an A record each) before you reload, or
# issuance fails.
#
# A request whose domain matches no block is refused. That is deliberate - the
# app answers only to the names listed here, so a stranger pointing their domain
# at this IP, or a bot scanning the raw address, gets nothing.

# ---------------------------------------------------------------- production
complaintsmgmt.com {
	reverse_proxy 127.0.0.1:8080
}

# Residents will type it with and without the www.
www.complaintsmgmt.com {
	redir https://complaintsmgmt.com{uri}
}

# ---------------------------------------------------------------------- beta
#
# Beta holds a copy of real resident data whenever it is refreshed from a
# production backup, so it is not left open. basic_auth keeps it behind a shared
# password and, as a side effect, out of search results. Generate the hash with:
#
#   caddy hash-password
#
# then paste it below and reload. Remove the basic_auth block if you would
# rather beta were public.
beta.complaintsmgmt.com {
	basic_auth {
		beta REPLACE_WITH_OUTPUT_OF_caddy_hash-password
	}
	reverse_proxy 127.0.0.1:8081
}
